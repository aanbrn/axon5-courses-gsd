{
  "$schema": "https://opencode.ai/config.json",

  // Project-local MCP servers. GSD's own server lives in .opencode/opencode.json
  // and is generated by the installer — do not duplicate it here.
  //
  // Secrets come from the environment, never from this file:
  //   "environment": { "MCP_API_KEY": "{env:MCP_API_KEY}" }
  // Pushes are human decisions. Commits are not: one GSD task makes several of them, so a
  // prompt on each only teaches approving without reading, and the individual commits are
  // squashed away on merge. The rule stays explicit here because the global config carries
  // the same `ask` and this entry is what overrides it.
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "allow",
      "git push *": "ask"
    }
  },

  "mcp": {
    "servers": {
      // Browser automation for frontend verification. Headless so it works in CI
      // and on a remote host; the agent drives the running SPA on :3000.
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.85", "--headless"]
      }
    }
  }
}
